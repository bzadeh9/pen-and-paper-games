// Prisma schema for Pen & Paper Games
// Covers: Auth (NextAuth), User Profiles, Game Stats, Leaderboard, Roles

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── NextAuth Models ────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core User Model ────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // hashed password for credential-based auth

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts         Account[]
  sessions         Session[]
  profile          Profile?
  gameStats        GameStats[]
  leaderboardEntry LeaderboardEntry?
  role             UserRole          @default(USER)
}

enum UserRole {
  USER
  ADMIN
}

// ─── User Profile ───────────────────────────────────────────────────

model Profile {
  id          String  @id @default(cuid())
  userId      String  @unique
  displayName String?
  avatarUrl   String?
  bio         String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Game Stats ─────────────────────────────────────────────────────

model GameStats {
  id       String @id @default(cuid())
  userId   String
  gameType String // e.g. "hold-the-line", "fences", etc.

  wins   Int @default(0)
  losses Int @default(0)
  draws  Int @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameType])
  @@index([gameType])
}

// ─── Leaderboard ────────────────────────────────────────────────────

model LeaderboardEntry {
  id     String @id @default(cuid())
  userId String @unique

  totalWins   Int @default(0)
  totalLosses Int @default(0)
  totalDraws  Int @default(0)
  score       Int @default(0) // computed score for ranking

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([score(sort: Desc)])
  @@index([totalWins(sort: Desc)])
}
